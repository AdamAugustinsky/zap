command PickStickerPicture = 87 {}

# The picture is measured and cropped upright: turned by its EXIF
# orientation first, as the system's decoder shows it (StickerPicture's size
# is the upright one too). No preview comes back: the dialog draws the
# source file itself, and the sticker is sent or added to the favourites.
command MakeSticker = 88 {
  source: path(4096)
  crop: StickerCrop
  transparent: bool
  emojis: list(32) str(64)
  chat: opt str(128)
  quoting: opt ReplyTarget
}

# The picture's size upright: turned by its EXIF orientation, as the
# system's decoder shows it (a photo stored sideways with orientation 6 is
# reported tall). Read from the header; the pixels are not decoded.
command InspectPicture = 89 {
  target: u64
  path: path(4096)
}

# A file is first turned upright by its EXIF orientation, as InspectPicture
# measures it, then turned `turns` quarter turns clockwise, then cropped:
# `crop` is in the picture after both turns. The file written (a JPEG, or a
# PNG when any pixel is see-through) carries no orientation of its own. A
# pasted picture has none to apply.
command ApplyPictureEdit = 90 {
  target: u64
  source: PictureSource
  width: u32
  height: u32
  crop: PictureCrop
  turns: u8
}

