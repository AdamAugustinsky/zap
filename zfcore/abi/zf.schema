}

# `rgba` is a blob put with zf_blob_put; a successful zf_send takes it.
command SendImage = 8 {
  chat: str(128)
  width: u32
  height: u32
  rgba: blob
  caption: opt str(65536)
  mentions: list(256) str(128)
  quoting: opt ReplyTarget
}

# `samples` is a blob put with zf_blob_put and taken by a successful
# zf_send: the recording as PCM, mono, 48,000 samples a second, each a
# little-endian IEEE-754 f32 nominally in -1.0 ..= 1.0 (values beyond are
# clipped by the encoder), so the blob's length is a multiple of 4 (else
# ZF_E_REFUSED). At most 15 minutes (172,800,000 bytes; longer is
# ZF_E_REFUSED with the blob untouched). The core normalizes the level
# itself (peak to 0.89, gain at most 10×), measures the seconds and the
# waveform, and encodes Opus in Ogg, as upstream's worker does. From the
# framework's 16-bit recorder at 48 kHz mono: each sample is s / 32768.0.
# At another rate or with several channels, average the channels to mono
# and resample to 48 kHz first (upstream's voice::mono_at_rate does it
# linearly). Upstream's window drops a recording under half a second.

command SendVoice = 9 {
  chat: str(128)
  samples: blob
  quoting: opt ReplyTarget
}

command SetOnline = 10 {
  online: bool
}

command Reconnect = 11 {}

