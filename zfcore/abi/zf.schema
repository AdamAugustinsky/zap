# ZapFast core ABI: every record that crosses zfcore's C ABI.
#
# One file generates both sides: `go run ./tools/abigen` in gnui/ writes
# zfcore/src/abi_gen.rs and gnui/abi/abi_gen.go, and `-check` fails when
# either is stale. The grammar (one declaration or field per line):
#
#   enum Name u8 { Variant = n ... }        a plain enum, one byte
#   struct Name { field: type ... }
#   union Name { Variant = n { fields } }   a tagged union, a one-byte tag
#   event Name = n { fields }               a variant of the root Event
#   command Name = n { fields }             a variant of the root Command
#
# Field types:
#   bool u8 u16 u32 u64 i32 i64 f32 f64     little-endian, fixed width
#   str(N)          UTF-8, at most N bytes (a u32 length, then the bytes)
#   bytes(N)        at most N bytes
#   path(N)         a file path's bytes, at most N
#   blob            a blob held by the core: u64 id, u64 length (zf_blob_read)
#   opt T           a presence byte, then T
#   list(N) T       a u32 count of at most N, then the elements
#   chunk(N, B) T   a list of at most N elements and B encoded bytes: the
#                   core splits a longer list over several records. B is
#                   512 KiB, or 576 KiB for lists of messages (and of starred
#                   or shared entries, which hold one): the largest message,
#                   196,608 bytes of text with 256 mentions in it and 256 in
#                   its quote, is over 512 KiB
#   Name            an enum, struct or union above
#
# Every record is a u16 variant tag, a u16 that must be zero, then its
# fields. The generator adds up each record's largest encoding and refuses a
# record that could exceed max_record. Tags are fixed once published: never
# renumber, only add.
#
# Comments and blank lines do not change the schema hash.

abi 1
max_record 1048576

# ---- shared types -------------------------------------------------------

enum Delivery u8 {
  None = 0
  Pending = 1
  Sent = 2
  Delivered = 3
  Read = 4
  Played = 5
  Failed = 6
}

enum ChatKind u8 {
  Direct = 0
  Group = 1
  Broadcast = 2
}

enum CallStatus u8 {
  Answered = 0
  AnsweredElsewhere = 1
  Missed = 2
  Declined = 3
  DeclinedElsewhere = 4
  Busy = 5
  Failed = 6
  NoAnswer = 7
  ConnectionLost = 8
}

enum OnceMedia u8 {
  Photo = 0
  Video = 1
  Voice = 2
  Audio = 3
}

enum Refusal u8 {
  Offline = 0
  QuoteUnavailable = 1
}

# The configuration record zf_core_open reads.
struct OpenConfig {
  abi: u32
  schema_hash: u64
  demo: bool
  # The app's state and cache roots; the account's folders go under
  # accounts/<account> in each.
  state_dir: path(4096)
  cache_dir: path(4096)
  account: str(16)
  # The OS keyring service the account's archive key is kept under: the
  # app's own identity, never upstream's. A real core refuses an empty one
  # or upstream's; one process keeps one service. The demo ignores it.
  keyring_service: str(256)
  # The app's name, which the phone shows for this computer under Linked
  # devices (with the computer's name) when it links; empty: upstream's
  # "ZapFast". One process keeps one name. The demo ignores it.
  device_name: str(64)
}

struct ReplyTarget {
  id: str(128)
  chat: opt str(128)
}

struct PageKey {
  timestamp: i64
  id: str(128)
}

union NotificationSound {
  Receive = 0 {}
  Alert = 1 {}
  System = 2 {}
  None = 3 {}
  Custom = 4 {
    path: path(4096)
  }
}

struct LastMessage {
  from_me: bool
  sender: str(128)
  sender_name: opt str(1024)
  summary: str(1024)
  # The whole message text: 64 Ki UTF-16 units, at most 3 bytes each.
  full: str(196608)
  status: Delivery
}

struct Chat {
  id: str(128)
  name: str(1024)
  group_subject_known: bool
  kind: ChatKind
  last_activity: i64
  unread: u32
  marked_unread: bool
  archived: bool
  pinned: bool
  pinned_at: i64
  muted_until: opt i64
  last: opt LastMessage
  favorite: bool
  favorite_position: u32
  participants: list(1024) str(128)
  group_description: opt str(8192)
  read_only: bool
  left: bool
  info_locked: opt bool
  admin: bool
  locked: bool
  ephemeral_expiration: opt u32
  labels: list(64) str(64)
  notification_sound: opt NotificationSound
  unread_mention: opt str(128)
}

struct Contact {
  id: str(128)
  full_name: opt str(1024)
  first_name: opt str(1024)
  push_name: opt str(1024)
}

struct MentionRef {
  user: str(128)
  id: str(128)
}

struct LinkPreview {
  url: str(4096)
  title: opt str(1024)
  description: opt str(4096)
}

struct Quoted {
  chat: opt str(128)
  id: str(128)
  sender: str(128)
  sender_name: opt str(1024)
  summary: str(1024)
  # As many as a command may send (MENTIONS in dto.rs), so an edit or a
  # quote of one round-trips.
  mentions: list(256) MentionRef
}

struct Reaction {
  sender: str(128)
  from_me: bool
  emoji: str(64)
}

union MediaState {
  Idle = 0 {}
  Downloading = 1 {}
  Failed = 2 {
    error: str(1024)
  }
}

struct Media {
  mime: str(256)
  size: u64
  width: opt u32
  height: opt u32
  album: opt str(128)
  path: opt path(4096)
  state: MediaState
}

struct Motion {
  path: opt path(4096)
  state: MediaState
}

# WhatsApp's own limits are far smaller (rows of 24 and 72 characters).
struct InteractiveOption {
  section: str(128)
  title: str(128)
  description: str(384)
}

union InteractiveAction {
  Unavailable = 0 {}
  Reply = 1 {}
  Copy = 2 {
    code: str(1024)
  }
  Select = 3 {
    options: list(10) InteractiveOption
  }
}

struct InteractiveButton {
  label: str(128)
  url: opt str(1024)
  action: InteractiveAction
}

# A carousel card: an InteractiveCard that holds no carousel itself.
struct CarouselCard {
  body: str(2048)
  buttons: list(2) InteractiveButton
  image: opt Media
  needs_phone: bool
  thumbnail: opt blob
}

struct InteractiveCard {
  body: str(16384)
  buttons: list(10) InteractiveButton
  image: opt Media
  needs_phone: bool
  carousel: list(10) CarouselCard
  thumbnail: opt blob
}

struct PollVoter {
  id: str(128)
  name: str(256)
  from_me: bool
  timestamp: i64
  choices: list(12) u64
}

struct PollState {
  selectable: u64
  counts: list(12) u64
  selected: list(12) u64
  voters: u64
  can_vote: bool
  history_complete: bool
  refresh_needed: bool
  refreshing: bool
  refresh_failed: bool
  votes: list(256) PollVoter
}

union Content {
  Text = 0 {
    text: str(196608)
    preview: opt LinkPreview
  }
  Interactive = 1 {
    text: str(16384)
    card: opt InteractiveCard
  }
  Image = 2 {
    caption: opt str(65536)
    media: Media
    motion: opt Motion
  }
  Video = 3 {
    caption: opt str(65536)
    media: Media
    seconds: opt u32
    gif: bool
    note: bool
  }
  Audio = 4 {
    media: Media
    seconds: opt u32
    voice_note: bool
    waveform: bytes(64)
  }
  Document = 5 {
    media: Media
    file_name: str(1024)
    caption: opt str(65536)
    pages: opt u32
  }
  Sticker = 6 {
    media: Media
    animated: bool
  }
  StickerPack = 7 {
    name: str(1024)
    publisher: str(1024)
    count: u32
    caption: opt str(65536)
  }
  Location = 8 {
    latitude: f64
    longitude: f64
    name: opt str(1024)
    address: opt str(4096)
  }
  LiveLocation = 9 {
    latitude: f64
    longitude: f64
    accuracy_m: opt u32
    speed_mps: opt f32
    heading_deg: opt u32
    sequence: i64
    ended: bool
    updated: i64
    newer_on_phone: bool
  }
  Contact = 10 {
    display_name: str(1024)
    vcard: str(65536)
  }
  Poll = 11 {
    question: str(1024)
    options: list(12) str(400)
    state: PollState
  }
  Revoked = 12 {}
  Unsupported = 13 {
    what: str(1024)
  }
  PhoneOnly = 14 {
    view_once: bool
    live_location: bool
    once: opt OnceMedia
  }
  Call = 15 {
    video: bool
    status: CallStatus
    duration: u64
    group: bool
  }
}

struct Message {
  id: str(128)
  chat: str(128)
  sender: str(128)
  sender_name: opt str(1024)
  from_me: bool
  timestamp: i64
  history_order: opt i64
  content: Content
  status: Delivery
  delivered_at: opt i64
  read_at: opt i64
  quoted: opt Quoted
  reactions: list(256) Reaction
  edited: bool
  # As many as a command may send (MENTIONS in dto.rs).
  mentions: list(256) MentionRef
  forwarded: bool
  # The JPEG preview, held by the core until freed.
  thumbnail: opt blob
}

union LinkStatus {
  Starting = 0 {}
  Unlinked = 1 {
    qr: opt str(1024)
    pair_code: opt str(64)
    pairing_phone: opt str(64)
  }
  Connecting = 2 {}
  Connected = 3 {}
  Disconnected = 4 {
    reason: str(1024)
  }
  LoggedOut = 5 {}
  Failed = 6 {
    error: str(4096)
  }
}

struct Draft {
  chat: str(128)
  text: str(196608)
}

# Straight-alpha RGBA rows, held by the core until freed.
struct DecodedImage {
  width: u32
  height: u32
  rgba: blob
}

union ClipboardImageResult {
  Ok = 0 {
    image: DecodedImage
  }
  Err = 1 {
    error: str(4096)
  }
}

union Unsent {
  Text = 0 {
    text: str(196608)
  }
  Location = 1 {
    latitude: f64
    longitude: f64
  }
  # Mono 48 kHz samples as little-endian f32.
  Voice = 2 {
    samples: blob
  }
  Files = 3 {
    paths: list(64) path(4096)
    documents: bool
    caption: opt str(65536)
  }
  Image = 4 {
    width: u32
    height: u32
    rgba: blob
    caption: opt str(65536)
  }
  Sticker = 5 {}
  Gif = 6 {}
}

enum PrivacyKind u8 {
  LastSeen = 0
  Online = 1
  Profile = 2
  About = 3
  GroupAdd = 4
  ReadReceipts = 5
  CallAdd = 6
}

enum PrivacyChoice u8 {
  Everyone = 0
  Contacts = 1
  Except = 2
  Nobody = 3
  SameAsLastSeen = 4
  Known = 5
}

struct PrivacyValue {
  kind: PrivacyKind
  choice: PrivacyChoice
}

enum CallDirection u8 {
  Incoming = 0
  Outgoing = 1
}

enum CallPhase u8 {
  Placing = 0
  Dialing = 1
  Ringing = 2
  Incoming = 3
  Connecting = 4
  Accepted = 5
  Active = 6
  Ended = 7
  Failed = 8
}

enum SilenceReason u8 {
  NoDecoder = 0
  AuthenticationFailing = 1
  UnexpectedPayloadType = 2
  CodecRejectingFrames = 3
  CodecFlapping = 4
  Unknown = 5
}

enum DeviceKind u8 {
  Microphone = 0
  Speaker = 1
  Camera = 2
}

union PeerAudio {
  Silent = 0 {
    reason: SilenceReason
  }
  Stalled = 1 {}
}

struct LostDevice {
  kind: DeviceKind
  name: str(1024)
}

struct Participant {
  id: str(128)
  joined: bool
  video: bool
}

struct GroupCall {
  caller: opt str(128)
  participants: list(1024) Participant
  link: bool
}

# One snapshot of the live call. `active_for_ms` is how long the call has
# been active when the record was made (upstream holds an Instant, which
# cannot cross): the UI counts from `now - active_for_ms`.
struct CallUpdate {
  generation: u64
  chat: str(128)
  direction: CallDirection
  video: bool
  phase: CallPhase
  active_for_ms: opt u64
  muted: bool
  camera_on: bool
  remote_video: bool
  video_requested: bool
  outcome: opt CallStatus
  peer_audio: opt PeerAudio
  lost_devices: list(8) LostDevice
  microphone: opt str(1024)
  speaker: opt str(1024)
  camera: opt str(1024)
  group: opt GroupCall
}

struct Device {
  id: str(1024)
  label: str(1024)
}

struct DeviceList {
  microphones: list(64) Device
  speakers: list(64) Device
  cameras: list(64) Device
}

# A local chat label. The id is the one a chat's `labels` carry.
struct Label {
  id: str(64)
  name: str(1024)
  color_hex: str(16)
  created_at: i64
}

# A message id, for lists that can be long.
struct MessageId {
  id: str(128)
}

struct Starred {
  message: Message
  starred_at: i64
}

struct Pinner {
  by_me: bool
  sender: str(128)
}

struct Pinned {
  chat: str(128)
  id: str(128)
  pinned_at: i64
  expires_at: i64
  # The message's own words, whole.
  text: str(196608)
  from_me: bool
  sent_at: i64
  pinner: Pinner
}

struct MediaItem {
  id: str(128)
  card: opt u64
  timestamp: i64
  video: bool
  path: opt path(4096)
  thumbnail: opt blob
}

# One row of a chat's shared media: the pictures and videos, the documents
# and the links in the order the core lists them, each kind newest first.
union SharedEntry {
  Media = 0 {
    message: Message
  }
  Doc = 1 {
    message: Message
  }
  Link = 2 {
    message: str(128)
    timestamp: i64
    url: str(4096)
    title: opt str(1024)
  }
}

struct StorageStats {
  images: u64
  image_bytes: u64
  videos: u64
  video_bytes: u64
  stickers: u64
  sticker_bytes: u64
  other: u64
  other_bytes: u64
}

struct Gif {
  id: str(128)
  still: opt path(4096)
  mp4: str(4096)
  width: u32
  height: u32
}

struct GifFailure {
  message: str(4096)
  bad_key: bool
}

# A sticker pack as a message shares it (WhatsApp allows 60 stickers); the
# picker's own packs travel as StickerEntry rows instead.
struct StickerPackInfo {
  name: str(1024)
  dir: path(4096)
  stickers: list(64) path(4096)
  local: bool
}

# One row of the sticker picker. A `Pack` opens a pack and the `PackSticker`
# rows after it, up to the next `Pack`, are its stickers.
union StickerEntry {
  Favorite = 0 {
    path: path(4096)
  }
  Pack = 1 {
    name: str(1024)
    dir: path(4096)
    local: bool
  }
  PackSticker = 2 {
    path: path(4096)
  }
  Recent = 3 {
    path: path(4096)
  }
  Received = 4 {
    path: path(4096)
  }
  # The emojis a sticker file is tagged with.
  Tagged = 5 {
    path: path(4096)
    emojis: list(32) str(64)
  }
}

union PathResult {
  Ok = 0 {
    path: path(4096)
  }
  Err = 1 {
    error: str(4096)
  }
}

union SizeResult {
  Ok = 0 {
    width: u32
    height: u32
  }
  Err = 1 {
    error: str(4096)
  }
}

union StickerPackResult {
  Ok = 0 {
    pack: StickerPackInfo
    publisher: str(1024)
  }
  Err = 1 {
    error: str(4096)
  }
}

struct InviteInfo {
  id: str(128)
  subject: str(1024)
  description: opt str(8192)
  members: u64
  approval: bool
}

union InviteResult {
  Ok = 0 {
    info: InviteInfo
  }
  Err = 1 {
    error: str(4096)
  }
}

union JoinResult {
  Ok = 0 {
    chat: str(128)
    pending: bool
  }
  Err = 1 {
    error: str(4096)
  }
}

struct Recipient {
  id: str(128)
  expected: bool
  delivered_at: opt i64
  read_at: opt i64
  played_at: opt i64
}

struct PollDraft {
  question: str(1024)
  options: list(12) str(400)
  multiple: bool
}

struct ReceiptTarget {
  chat: str(128)
  message: str(128)
}

struct SaveFile {
  source: path(4096)
  name: str(1024)
}

struct StickerCrop {
  x: u32
  y: u32
  side: u32
}

struct PictureCrop {
  x: u32
  y: u32
  width: u32
  height: u32
}

union PictureSource {
  File = 0 {
    path: path(4096)
  }
  # Straight RGBA rows, width × height × 4 bytes, taken by zf_send.
  Pasted = 1 {
    rgba: blob
  }
}

enum PickKind u8 {
  File = 0
  Files = 1
  Folder = 2
  Save = 3
}

# A file-type filter: a name and the extensions it allows, without dots.
struct PickFilter {
  name: str(256)
  extensions: list(32) str(32)
}

# ---- events (core to UI) ------------------------------------------------

# Chunked events (Chats, Messages, Contacts, Drafts and the ones below): a
# list too long for one record arrives as chunks that share a `batch` and
# arrive in order; the first chunk of a new batch replaces what the last
# batch said (unless the event says it prepends), `last` closes it, and a
# flag a whole batch has (`complete`, `truncated`) is true on the last chunk
# only. An empty list is one chunk, empty and last.

# zfcore's own: a record that could not be encoded within its bounds was
# dropped. Carries the variant's tag and the size it reached, never content.
event EventDropped = 1 {
  kind: u16
  size: u64
}

# zfcore's own: a core thread panicked. The core keeps no promises after it.
event Fatal = 2 {
  origin: str(64)
  thread: str(128)
  location: str(1024)
}

event Link = 10 {
  status: LinkStatus
}

event Me = 11 {
  id: str(128)
  lid: opt str(128)
  name: opt str(1024)
  about: opt str(1024)
}

# The full chat list, newest first, in chunks: apply each as it arrives;
# `last` closes the batch.
event Chats = 12 {
  batch: u32
  last: bool
  chats: chunk(256, 524288) Chat
}

event ChatUpdated = 13 {
  chat: Chat
}

# Chat messages in ascending order, in chunks of one batch, in order. An
# `older` batch is prepended as a whole: each chunk goes after the previous
# chunk of its batch. `complete` (on the last chunk only) means the archive
# has no earlier rows.
event Messages = 14 {
  chat: str(128)
  batch: u32
  last: bool
  older: bool
  complete: bool
  messages: chunk(256, 589824) Message
}

event MessageUpdated = 15 {
  message: Message
}

event Incoming = 16 {
  chat: str(128)
  message: Message
}

event Contacts = 17 {
  batch: u32
  last: bool
  contacts: chunk(4096, 524288) Contact
}

event Typing = 18 {
  chat: str(128)
  sender: str(128)
  composing: bool
}

event Presence = 19 {
  id: str(128)
  online: bool
  last_seen: opt i64
}

event Drafts = 20 {
  batch: u32
  last: bool
  drafts: chunk(4096, 524288) Draft
}

event Picked = 21 {
  chat: str(128)
  paths: list(64) path(4096)
  documents: bool
}

event Syncing = 22 {
  syncing: bool
}

event SyncProgress = 23 {
  percent: u32
}

event PinLimit = 24 {
  limit: u64
}

event Info = 25 {
  text: str(4096)
}

event Error = 26 {
  text: str(4096)
}

event ClipboardImage = 27 {
  result: ClipboardImageResult
}

event SendRefused = 28 {
  chat: str(128)
  quoting: opt ReplyTarget
  unsent: Unsent
  reason: Refusal
}

event AccountRemoved = 29 {}

event InteractiveReplyState = 30 {
  chat: str(128)
  message: str(128)
  pending: bool
}

event PollCreated = 31 {
  chat: str(128)
  error: opt str(4096)
}

event ForwardLimit = 32 {
  from_chat: str(128)
  messages: list(1024) str(128)
  limit: u64
}

event PollVoted = 33 {
  chat: str(128)
  message: str(128)
  error: opt str(4096)
}

# Every label in creation order, in chunks.
event Labels = 34 {
  batch: u32
  last: bool
  labels: chunk(1024, 524288) Label
}

# The starred message ids of one chat, in chunks.
event Stars = 35 {
  chat: str(128)
  batch: u32
  last: bool
  ids: chunk(4096, 524288) MessageId
}

event StarChanged = 36 {
  chat: str(128)
  message: str(128)
  starred: bool
  local: bool
}

# The starred messages, newest star first, in chunks.
event StarredList = 37 {
  batch: u32
  last: bool
  starred: chunk(256, 589824) Starred
}

# Matches of one chat's search, newest first, in chunks; `truncated` says the
# archive held more (last chunk only).
event ChatHits = 38 {
  chat: str(128)
  query: str(4096)
  from: opt i64
  until: opt i64
  batch: u32
  last: bool
  truncated: bool
  messages: chunk(256, 589824) Message
}

# A chat's shared media in chunks of rows (see SharedEntry). On a failure
# `error` is set, `chat` is empty and there is one empty last chunk. The truncated flags are
# true on the last chunk only.
event ChatShared = 39 {
  request: u64
  chat: str(128)
  error: opt str(4096)
  batch: u32
  last: bool
  media_truncated: bool
  docs_truncated: bool
  links_truncated: bool
  entries: chunk(256, 589824) SharedEntry
}

event ChatSharedChanged = 40 {
  chat: str(128)
}

# A page of a chat's photos and clips, oldest first, in chunks.
event ChatMedia = 41 {
  chat: str(128)
  around: opt str(128)
  batch: u32
  last: bool
  items: chunk(1024, 524288) MediaItem
}

# The active pins of one chat, in chunks.
event Pins = 42 {
  chat: str(128)
  batch: u32
  last: bool
  items: chunk(8, 524288) Pinned
}

event PinChanged = 43 {
  chat: str(128)
  message: str(128)
  pinned: bool
}

event StorageStats = 44 {
  stats: opt StorageStats
  token: u64
  cleared: bool
}

# Message search results, newest first, in chunks.
event SearchHits = 45 {
  query: str(4096)
  batch: u32
  last: bool
  messages: chunk(256, 589824) Message
}

event Avatar = 46 {
  id: str(128)
  full: bool
  path: opt path(4096)
}

event MessageDeleted = 47 {
  chat: str(128)
  id: str(128)
}

event ChatRemoved = 48 {
  chat: str(128)
}

event ChatCleared = 49 {
  chat: str(128)
  through: i64
}

# GIF search results in chunks, or a failure (`error`, then one empty last
# chunk).
event Gifs = 50 {
  query: str(4096)
  error: opt GifFailure
  batch: u32
  last: bool
  gifs: chunk(256, 524288) Gif
}

event StickerPicture = 51 {
  path: path(4096)
  width: u32
  height: u32
  transparent: bool
}

event PictureInspected = 52 {
  target: u64
  result: SizeResult
}

event PictureEdited = 53 {
  target: u64
  result: PathResult
}

event StickerPackPreview = 54 {
  result: StickerPackResult
}

# The sticker picker's whole state, in chunks of rows (see StickerEntry).
event Stickers = 55 {
  batch: u32
  last: bool
  entries: chunk(4096, 524288) StickerEntry
}

