# ---------------------------------------------------------------------------
# Fourth batch of strings added by the Go port (gnui): the updater's two newest
# refusals, the chat-history banner with its ellipsis, the product name, and
# the application menu's titles, which the menu bar will take once the
# framework lets it (Apple's wording). Sorted by context, then msgid.
# ---------------------------------------------------------------------------

#: gnui/ui/shell/shell.go:1472
msgid "Loading chat history…"
msgstr "Sohbet geçmişi yükleniyor…"

#. Translators: {percent} is a number, 0 to 100.
#: gnui/ui/shell/shell.go:1470
msgid "Loading chat history… {percent}%"
msgstr "Sohbet geçmişi yükleniyor… {percent}%"

#. Translators: {got} and {announced} are version numbers.
#: gnui/ui/settings/install.go:272
msgid ""
"The update is version {got}, not the {announced} it announced, so it was "
"not installed."
msgstr ""
"Güncelleme {got} sürümü, duyurulan {announced} değil, bu yüzden yüklenmedi."

#: gnui/ui/settings/updater.go:436
msgid ""
"The update's file does not belong to the version it announces, so it was "
"not installed."
msgstr ""
"Güncellemenin dosyası duyurduğu sürüme ait değil, bu yüzden yüklenmedi."

#. Translators: the product name; keep it.
#: gnui/ui/viewer/viewer.go:115
