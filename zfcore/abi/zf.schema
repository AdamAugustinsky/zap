}

# The call entries, newest first, in chunks.
event CallLog = 74 {
  batch: u32
  last: bool
  messages: chunk(256, 589824) Message
}

event GroupSaving = 75 {
  chat: str(128)
  saving: bool
}

# A file dialog for the UI to show. The core waits for the answer, so every
# request must be answered once with PickAnswer: with no paths when the
# reader cancels. The core cuts a title, name or filter list that is over its
# bound instead of dropping the request.
event PickRequest = 76 {
  id: u64
  kind: PickKind
  title: str(1024)
  filters: list(16) PickFilter
  file_name: opt str(1024)
  directory: opt path(4096)
}

# A file for the UI to open in its default application, or to show in its
# folder when nothing opens it (the log, from OpenLog). The core does not
# open files itself.
event OpenPath = 77 {
  path: path(4096)
}

# ---- commands (UI to core) ----------------------------------------------

command LoadChat = 1 {
  chat: str(128)
  before: opt PageKey
}

command SendText = 2 {
  chat: str(128)
  text: str(196608)
  quoting: opt ReplyTarget
  mentions: list(256) str(128)
}

